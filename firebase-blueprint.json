{
  "entities": {
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public survivor profile visible to other online players.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24
        },
        "coatColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "scarfColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "hatStyle": {
          "type": "string",
          "enum": ["hood", "beanie", "santa_hat", "ushanka"]
        },
        "friendCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "level": {
          "type": "number"
        },
        "xp": {
          "type": "number"
        },
        "escapes": {
          "type": "number"
        },
        "gamesPlayed": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "coatColor",
        "scarfColor",
        "hatStyle",
        "friendCode",
        "level",
        "xp",
        "escapes",
        "gamesPlayed",
        "createdAt",
        "updatedAt"
      ]
    },
    "PrivateUserInfo": {
      "title": "PrivateUserInfo",
      "description": "Private PII user account record accessible only to the account owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "FriendCodeLookup": {
      "title": "FriendCodeLookup",
      "description": "Public lookup mapping a short friend code to a survivor UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "friendCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "friendCode", "createdAt"]
    },
    "FriendRecord": {
      "title": "FriendRecord",
      "description": "Bidirectional friend connection or request inside a user's friends subcollection.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "friendUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "coatColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "scarfColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "hatStyle": {
          "type": "string",
          "enum": ["hood", "beanie", "santa_hat", "ushanka"]
        },
        "friendCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[A-Z0-9_\\-]+$"
        },
        "level": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["pending_sent", "pending_received", "accepted"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "friendUid",
        "displayName",
        "coatColor",
        "scarfColor",
        "hatStyle",
        "friendCode",
        "level",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "GlobalChatMessage": {
      "title": "GlobalChatMessage",
      "description": "Lobby chat message shared among signed-in survivors.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "coatColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "channel": {
          "type": "string",
          "enum": ["global"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["senderId", "senderName", "coatColor", "channel", "text", "createdAt"]
    },
    "GameRoom": {
      "title": "GameRoom",
      "description": "Online multiplayer maze room state and shared progression.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "difficulty": {
          "type": "string",
          "enum": ["normal", "nightmare", "insane"]
        },
        "level": {
          "type": "number"
        },
        "mazeSeed": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["waiting", "playing", "finished"]
        },
        "collectedOrnaments": {
          "type": "array"
        },
        "collectedWeapons": {
          "type": "array"
        },
        "collectedBatteries": {
          "type": "array"
        },
        "triggeredTraps": {
          "type": "array"
        },
        "weaponWave": {
          "type": "number"
        },
        "santaStunNonce": {
          "type": "number"
        },
        "ornamentsTotal": {
          "type": "number"
        },
        "exitUnlocked": {
          "type": "boolean"
        },
        "isPublic": {
          "type": "boolean"
        },
        "playerCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "roomId",
        "name",
        "hostId",
        "hostName",
        "difficulty",
        "level",
        "mazeSeed",
        "status",
        "collectedOrnaments",
        "collectedWeapons",
        "collectedBatteries",
        "triggeredTraps",
        "weaponWave",
        "santaStunNonce",
        "ornamentsTotal",
        "exitUnlocked",
        "isPublic",
        "playerCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoomPlayer": {
      "title": "RoomPlayer",
      "description": "Real-time player transform, customization, and status inside a multiplayer room.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "coatColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "scarfColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "hatStyle": {
          "type": "string",
          "enum": ["hood", "beanie", "santa_hat", "ushanka"]
        },
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "yaw": {
          "type": "number"
        },
        "flashlightOn": {
          "type": "boolean"
        },
        "alive": {
          "type": "boolean"
        },
        "escaped": {
          "type": "boolean"
        },
        "stunned": {
          "type": "boolean"
        },
        "equippedWeapon": {
          "type": "string",
          "enum": ["", "tranq_dart", "cryo_blaster", "candy_bat"]
        },
        "shotCount": {
          "type": "number"
        },
        "lastShotHit": {
          "type": "boolean"
        },
        "reviveCount": {
          "type": "number"
        },
        "revivedBy": {
          "type": "string",
          "minLength": 0,
          "maxLength": 24
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "roomId",
        "displayName",
        "coatColor",
        "scarfColor",
        "hatStyle",
        "x",
        "z",
        "yaw",
        "flashlightOn",
        "alive",
        "escaped",
        "stunned",
        "equippedWeapon",
        "shotCount",
        "lastShotHit",
        "reviveCount",
        "revivedBy",
        "updatedAt"
      ]
    },
    "SantaLiveState": {
      "title": "SantaLiveState",
      "description": "Host-authoritative Evil Santa position, alert, and stun state for a room.",
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "yaw": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "alerted": {
          "type": "boolean"
        },
        "stunRemaining": {
          "type": "number"
        },
        "extras": {
          "type": "array",
          "description": "Additional active Evil Santa states for levels 50+ (up to 2 extra Santas)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["x", "z", "yaw", "speed", "alerted", "stunRemaining", "extras", "updatedAt"]
    },
    "RoomChatMessage": {
      "title": "RoomChatMessage",
      "description": "In-room / in-game chat message sent by a joined survivor.",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "coatColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "roomId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["senderId", "senderName", "coatColor", "roomId", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/public/profile": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public survivor profile without PII."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/PrivateUserInfo" },
      "description": "Owner-only PII record (email)."
    },
    "/users/{userId}/friends/{friendId}": {
      "schema": { "$ref": "#/entities/FriendRecord" },
      "description": "Bidirectional friend connections and requests."
    },
    "/friendCodes/{code}": {
      "schema": { "$ref": "#/entities/FriendCodeLookup" },
      "description": "Short friend code lookup mapping."
    },
    "/globalChat/{messageId}": {
      "schema": { "$ref": "#/entities/GlobalChatMessage" },
      "description": "Global lobby survivor chat."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/GameRoom" },
      "description": "Multiplayer maze match rooms."
    },
    "/rooms/{roomId}/players/{playerId}": {
      "schema": { "$ref": "#/entities/RoomPlayer" },
      "description": "Real-time player states in a room."
    },
    "/rooms/{roomId}/santa/live": {
      "schema": { "$ref": "#/entities/SantaLiveState" },
      "description": "Host-authoritative Evil Santa live transform."
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RoomChatMessage" },
      "description": "In-room chat messages."
    }
  }
}
