rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'jaydentorru4@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidFriendCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 16 && code.matches('^[A-Z0-9_\\-]+$');
    }

    function isValidColor(color) {
      return color is string && color.size() == 7 && color.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidHatStyle(style) {
      return style is string && style in ['hood', 'beanie', 'santa_hat', 'ushanka'];
    }

    // Entity validation blueprints
    function isValidPublicProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'coatColor', 'scarfColor', 'hatStyle',
          'friendCode', 'level', 'xp', 'escapes', 'gamesPlayed', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'coatColor', 'scarfColor', 'hatStyle',
          'friendCode', 'level', 'xp', 'escapes', 'gamesPlayed', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 24
        && isValidColor(data.coatColor)
        && isValidColor(data.scarfColor)
        && isValidHatStyle(data.hatStyle)
        && isValidFriendCode(data.friendCode)
        && data.level is number
        && data.level >= 1 && data.level <= 99
        && data.xp is number
        && data.xp >= 0 && data.xp <= 1000000
        && data.escapes is number
        && data.escapes >= 0 && data.escapes <= 100000
        && data.gamesPlayed is number
        && data.gamesPlayed >= 0 && data.gamesPlayed <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFriendCodeLookup(data) {
      return data.keys().hasAll(['uid', 'friendCode', 'createdAt'])
        && data.keys().hasOnly(['uid', 'friendCode', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidFriendCode(data.friendCode)
        && data.createdAt is timestamp;
    }

    function isValidFriendRecord(data) {
      return data.keys().hasAll([
          'ownerUid', 'friendUid', 'displayName', 'coatColor', 'scarfColor',
          'hatStyle', 'friendCode', 'level', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'friendUid', 'displayName', 'coatColor', 'scarfColor',
          'hatStyle', 'friendCode', 'level', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerUid)
        && isValidId(data.friendUid)
        && data.ownerUid != data.friendUid
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 24
        && isValidColor(data.coatColor)
        && isValidColor(data.scarfColor)
        && isValidHatStyle(data.hatStyle)
        && isValidFriendCode(data.friendCode)
        && data.level is number
        && data.level >= 1 && data.level <= 99
        && data.status in ['pending_sent', 'pending_received', 'accepted']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGlobalChatMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'coatColor', 'channel', 'text', 'createdAt'])
        && data.keys().hasOnly(['senderId', 'senderName', 'coatColor', 'channel', 'text', 'createdAt'])
        && isValidId(data.senderId)
        && data.senderId == request.auth.uid
        && data.senderName is string
        && data.senderName.size() >= 1 && data.senderName.size() <= 24
        && isValidColor(data.coatColor)
        && data.channel == 'global'
        && data.text is string
        && data.text.size() >= 1 && data.text.size() <= 240
        && data.createdAt is timestamp;
    }

    function isValidRoom(data) {
      return data.keys().hasAll([
          'roomId', 'name', 'hostId', 'hostName', 'difficulty', 'level', 'mazeSeed',
          'status', 'collectedOrnaments', 'collectedWeapons', 'collectedBatteries',
          'triggeredTraps', 'weaponWave', 'santaStunNonce', 'ornamentsTotal',
          'exitUnlocked', 'isPublic', 'playerCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'roomId', 'name', 'hostId', 'hostName', 'difficulty', 'level', 'mazeSeed',
          'status', 'collectedOrnaments', 'collectedWeapons', 'collectedBatteries',
          'triggeredTraps', 'weaponWave', 'santaStunNonce', 'ornamentsTotal',
          'exitUnlocked', 'isPublic', 'playerCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.roomId)
        && data.roomId.size() >= 4 && data.roomId.size() <= 32
        && data.name is string
        && data.name.size() >= 2 && data.name.size() <= 40
        && isValidId(data.hostId)
        && data.hostName is string
        && data.hostName.size() >= 1 && data.hostName.size() <= 24
        && data.difficulty in ['normal', 'nightmare', 'insane']
        && data.level is number
        && data.level >= 1 && data.level <= 99
        && data.mazeSeed is number
        && data.status in ['waiting', 'playing', 'finished']
        && data.collectedOrnaments is list
        && data.collectedOrnaments.size() <= 18
        && (data.collectedOrnaments.size() == 0 || data.collectedOrnaments[0] is number)
        && data.collectedWeapons is list
        && data.collectedWeapons.size() <= 40
        && (data.collectedWeapons.size() == 0 || data.collectedWeapons[0] is number)
        && data.collectedBatteries is list
        && data.collectedBatteries.size() <= 30
        && (data.collectedBatteries.size() == 0 || data.collectedBatteries[0] is number)
        && data.triggeredTraps is list
        && data.triggeredTraps.size() <= 20
        && (data.triggeredTraps.size() == 0 || data.triggeredTraps[0] is number)
        && data.weaponWave is number
        && data.weaponWave >= 0 && data.weaponWave <= 99
        && data.santaStunNonce is number
        && data.santaStunNonce >= 0 && data.santaStunNonce <= 10000
        && data.ornamentsTotal is number
        && data.ornamentsTotal >= 1 && data.ornamentsTotal <= 18
        && data.exitUnlocked is bool
        && data.isPublic is bool
        && data.playerCount is number
        && data.playerCount >= 0 && data.playerCount <= 12
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoomPlayer(data) {
      return data.keys().hasAll([
          'uid', 'roomId', 'displayName', 'coatColor', 'scarfColor', 'hatStyle',
          'x', 'z', 'yaw', 'flashlightOn', 'alive', 'escaped',
          'stunned', 'equippedWeapon', 'shotCount', 'lastShotHit',
          'reviveCount', 'revivedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'roomId', 'displayName', 'coatColor', 'scarfColor', 'hatStyle',
          'x', 'z', 'yaw', 'flashlightOn', 'alive', 'escaped',
          'stunned', 'equippedWeapon', 'shotCount', 'lastShotHit',
          'reviveCount', 'revivedBy', 'updatedAt'
        ])
        && isValidId(data.uid)
        && isValidId(data.roomId)
        && data.roomId.size() >= 4 && data.roomId.size() <= 32
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 24
        && isValidColor(data.coatColor)
        && isValidColor(data.scarfColor)
        && isValidHatStyle(data.hatStyle)
        && data.x is number
        && data.x >= -260 && data.x <= 260
        && data.z is number
        && data.z >= -260 && data.z <= 260
        && data.yaw is number
        && data.flashlightOn is bool
        && data.alive is bool
        && data.escaped is bool
        && data.stunned is bool
        && data.equippedWeapon is string
        && data.equippedWeapon in ['', 'tranq_dart', 'cryo_blaster', 'candy_bat']
        && data.shotCount is number
        && data.shotCount >= 0 && data.shotCount <= 10000
        && data.lastShotHit is bool
        && data.reviveCount is number
        && data.reviveCount >= 0 && data.reviveCount <= 1000
        && data.revivedBy is string
        && data.revivedBy.size() <= 24
        && data.updatedAt is timestamp;
    }

    function isValidExtraSanta(item) {
      return item is map
        && item.keys().hasAll(['x', 'z', 'yaw', 'speed', 'alerted', 'stunRemaining'])
        && item.keys().hasOnly(['x', 'z', 'yaw', 'speed', 'alerted', 'stunRemaining'])
        && item.x is number
        && item.x >= -260 && item.x <= 260
        && item.z is number
        && item.z >= -260 && item.z <= 260
        && item.yaw is number
        && item.speed is number
        && item.speed >= 0 && item.speed <= 25
        && item.alerted is bool
        && item.stunRemaining is number
        && item.stunRemaining >= 0 && item.stunRemaining <= 35;
    }

    function isValidSantaState(data) {
      return data.keys().hasAll(['x', 'z', 'yaw', 'speed', 'alerted', 'stunRemaining', 'extras', 'updatedAt'])
        && data.keys().hasOnly(['x', 'z', 'yaw', 'speed', 'alerted', 'stunRemaining', 'extras', 'updatedAt'])
        && data.x is number
        && data.x >= -260 && data.x <= 260
        && data.z is number
        && data.z >= -260 && data.z <= 260
        && data.yaw is number
        && data.speed is number
        && data.speed >= 0 && data.speed <= 25
        && data.alerted is bool
        && data.stunRemaining is number
        && data.stunRemaining >= 0 && data.stunRemaining <= 35
        && data.extras is list
        && data.extras.size() <= 2
        && (data.extras.size() < 1 || isValidExtraSanta(data.extras[0]))
        && (data.extras.size() < 2 || isValidExtraSanta(data.extras[1]))
        && data.updatedAt is timestamp;
    }

    function isValidRoomChatMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'coatColor', 'roomId', 'text', 'createdAt'])
        && data.keys().hasOnly(['senderId', 'senderName', 'coatColor', 'roomId', 'text', 'createdAt'])
        && isValidId(data.senderId)
        && data.senderId == request.auth.uid
        && data.senderName is string
        && data.senderName.size() >= 1 && data.senderName.size() <= 24
        && isValidColor(data.coatColor)
        && isValidId(data.roomId)
        && data.roomId.size() >= 4 && data.roomId.size() <= 32
        && data.text is string
        && data.text.size() >= 1 && data.text.size() <= 240
        && data.createdAt is timestamp;
    }

    // Public Survivor Profiles (no PII)
    match /users/{userId}/public/profile {
      allow get: if (isSignedIn() && isValidId(userId)) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId)
        && isValidId(userId)
        && isValidPublicProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time) || (isAdmin() && isValidId(userId));
      allow update: if (isOwner(userId)
        && isValidId(userId)
        && isValidPublicProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'coatColor', 'scarfColor', 'hatStyle',
          'friendCode', 'level', 'xp', 'escapes', 'gamesPlayed', 'updatedAt'
        ])) || (isAdmin() && isValidId(userId));
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Private PII User Info (owner or verified admin only)
    match /users/{userId}/private/info {
      allow get: if (isOwner(userId) && isValidId(userId)) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId)
        && isValidId(userId)
        && isValidPrivateInfo(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time) || (isAdmin() && isValidId(userId));
      allow update: if (isOwner(userId)
        && isValidId(userId)
        && isValidPrivateInfo(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])) || (isAdmin() && isValidId(userId));
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Collection-group listing for verified admin database mirroring & status inspection
    match /{path=**}/public/{docId} {
      allow get, list: if isAdmin();
    }

    match /{path=**}/info/{docId} {
      allow get, list: if isAdmin();
    }

    match /{path=**}/friends/{friendId} {
      allow get, list: if isAdmin();
    }

    match /{path=**}/players/{playerId} {
      allow get, list: if isAdmin();
    }

    match /{path=**}/santa/{docId} {
      allow get, list: if isAdmin();
    }

    match /{path=**}/messages/{messageId} {
      allow get, list: if isAdmin();
    }

    // Friends Subcollection (owner reads/lists own; sender/recipient create/accept/remove)
    match /users/{userId}/friends/{friendId} {
      allow get: if (isOwner(userId) && isValidId(userId) && isValidId(friendId)) || isAdmin();
      allow list: if (isOwner(userId) && isValidId(userId) && existing().ownerUid == userId) || isAdmin();
      allow create: if (isSignedIn()
        && isValidId(userId)
        && isValidId(friendId)
        && userId != friendId
        && isValidFriendRecord(incoming())
        && incoming().ownerUid == userId
        && incoming().friendUid == friendId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (request.auth.uid == userId && incoming().status == 'pending_sent')
          ||
          (request.auth.uid == friendId && incoming().status == 'pending_received')
        )) || (isAdmin() && isValidId(userId) && isValidId(friendId));
      allow update: if (isSignedIn()
        && isValidId(userId)
        && isValidId(friendId)
        && isValidFriendRecord(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().friendUid == existing().friendUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'displayName', 'coatColor', 'scarfColor', 'hatStyle', 'level', 'updatedAt'
            ])
          )
          ||
          (
            request.auth.uid == friendId
            && existing().status == 'pending_sent'
            && incoming().status == 'accepted'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'displayName', 'coatColor', 'scarfColor', 'hatStyle', 'level', 'updatedAt'
            ])
          )
        )) || (isAdmin() && isValidId(userId) && isValidId(friendId));
      allow delete: if (isSignedIn()
        && isValidId(userId)
        && isValidId(friendId)
        && (request.auth.uid == userId || request.auth.uid == friendId)) || isAdmin();
    }

    // Short Friend Code Lookup (no PII, get only)
    match /friendCodes/{code} {
      allow get: if (isSignedIn() && isValidFriendCode(code)) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isSignedIn()
        && isValidFriendCode(code)
        && isValidFriendCodeLookup(incoming())
        && incoming().friendCode == code
        && incoming().createdAt == request.time) || (isAdmin() && isValidFriendCode(code));
      allow update, delete: if isAdmin() && isValidFriendCode(code);
    }

    // Global Lobby Chat
    match /globalChat/{messageId} {
      allow get: if (isSignedIn() && isValidId(messageId) && existing().channel == 'global') || isAdmin();
      allow list: if (isSignedIn() && existing().channel == 'global') || isAdmin();
      allow create: if (isSignedIn()
        && isValidId(messageId)
        && isValidGlobalChatMessage(incoming())
        && incoming().createdAt == request.time) || (isAdmin() && isValidId(messageId));
      allow update: if isAdmin() && isValidId(messageId);
      allow delete: if (isSignedIn() && isValidId(messageId) && existing().channel == 'global') || isAdmin();
    }

    // Multiplayer Rooms
    match /rooms/{roomId} {
      allow get: if (isSignedIn() && isValidId(roomId)) || isAdmin();
      allow list: if (isSignedIn() && existing().isPublic == true) || isAdmin();
      allow create: if (isSignedIn()
        && isValidId(roomId)
        && isValidRoom(incoming())
        && incoming().roomId == roomId
        && incoming().hostId == request.auth.uid
        && incoming().status == 'waiting'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time) || (isAdmin() && isValidId(roomId));
      allow update: if (isSignedIn()
        && isValidId(roomId)
        && isValidRoom(incoming())
        && existing().status != 'finished'
        && incoming().roomId == existing().roomId
        && incoming().mazeSeed == existing().mazeSeed
        && incoming().difficulty == existing().difficulty
        && incoming().level == existing().level
        && incoming().ornamentsTotal == existing().ornamentsTotal
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Host controls match lifecycle & weapon waves
          (
            existing().hostId == request.auth.uid
            && incoming().hostId == existing().hostId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'playerCount', 'collectedOrnaments', 'collectedWeapons',
              'collectedBatteries', 'triggeredTraps', 'weaponWave',
              'santaStunNonce', 'exitUnlocked', 'updatedAt'
            ])
          )
          ||
          // Action 2: Joined survivor collects ornaments, weapons, batteries, triggers traps, stuns Santa, or updates headcount
          (
            incoming().hostId == existing().hostId
            && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'playerCount', 'collectedOrnaments', 'collectedWeapons',
              'collectedBatteries', 'triggeredTraps', 'santaStunNonce', 'exitUnlocked', 'updatedAt'
            ])
          )
          ||
          // Action 3: Host handoff when current host transfers or disconnects
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'hostId', 'hostName', 'playerCount', 'updatedAt'
            ])
            && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(incoming().hostId))
            && (
              existing().hostId == request.auth.uid
              ||
              (
                !exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(existing().hostId))
                && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid))
                && incoming().hostId == request.auth.uid
              )
            )
          )
        )) || (isAdmin() && isValidId(roomId));
      allow delete: if (isSignedIn()
        && isValidId(roomId)
        && (
          existing().hostId == request.auth.uid
          || (existing().playerCount <= 1 && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid)))
        )) || isAdmin();

      // Room Players (Master Gate verifies parent room exists)
      match /players/{playerId} {
        allow get: if (isSignedIn()
          && isValidId(roomId)
          && isValidId(playerId)
          && exists(/databases/$(database)/documents/rooms/$(roomId))) || isAdmin();
        allow list: if (isSignedIn() && existing().roomId == roomId) || isAdmin();
        allow create: if (isOwner(playerId)
          && isValidId(roomId)
          && isValidId(playerId)
          && isValidRoomPlayer(incoming())
          && incoming().uid == request.auth.uid
          && incoming().roomId == roomId
          && incoming().reviveCount == 0
          && incoming().revivedBy == ''
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/rooms/$(roomId))) || (isAdmin() && isValidId(roomId) && isValidId(playerId));
        allow update: if (isSignedIn()
          && isValidId(roomId)
          && isValidId(playerId)
          && isValidRoomPlayer(incoming())
          && incoming().uid == existing().uid
          && incoming().roomId == existing().roomId
          && incoming().updatedAt == request.time
          && (
            // Action 1: Owner updates their transform, gear, or caught/escaped state
            (
              request.auth.uid == playerId
              && incoming().reviveCount == existing().reviveCount
              && incoming().revivedBy == existing().revivedBy
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'displayName', 'coatColor', 'scarfColor', 'hatStyle',
                'x', 'z', 'yaw', 'flashlightOn', 'alive', 'escaped',
                'stunned', 'equippedWeapon', 'shotCount', 'lastShotHit', 'updatedAt'
              ])
            )
            ||
            // Action 2: Joined teammate revives a fallen survivor
            (
              request.auth.uid != playerId
              && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid))
              && existing().alive == false
              && existing().escaped == false
              && incoming().alive == true
              && incoming().reviveCount == existing().reviveCount + 1
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'alive', 'reviveCount', 'revivedBy', 'updatedAt'
              ])
            )
          )) || (isAdmin() && isValidId(roomId) && isValidId(playerId));
        allow delete: if (isOwner(playerId) && isValidId(roomId) && isValidId(playerId)) || isAdmin();
      }

      // Host-Authoritative Evil Santa Live State
      match /santa/live {
        allow get: if (isSignedIn()
          && isValidId(roomId)
          && exists(/databases/$(database)/documents/rooms/$(roomId))) || isAdmin();
        allow list: if isAdmin();
        allow create: if (isSignedIn()
          && isValidId(roomId)
          && isValidSantaState(incoming())
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid) || (isAdmin() && isValidId(roomId));
        allow update: if (isSignedIn()
          && isValidId(roomId)
          && isValidSantaState(incoming())
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['x', 'z', 'yaw', 'speed', 'alerted', 'stunRemaining', 'extras', 'updatedAt'])
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid) || (isAdmin() && isValidId(roomId));
        allow delete: if isAdmin() && isValidId(roomId);
      }

      // Room-Scoped Live Chat
      match /messages/{messageId} {
        allow get: if (isSignedIn()
          && isValidId(roomId)
          && isValidId(messageId)
          && exists(/databases/$(database)/documents/rooms/$(roomId))) || isAdmin();
        allow list: if (isSignedIn() && existing().roomId == roomId) || isAdmin();
        allow create: if (isSignedIn()
          && isValidId(roomId)
          && isValidId(messageId)
          && isValidRoomChatMessage(incoming())
          && incoming().roomId == roomId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid))) || (isAdmin() && isValidId(roomId) && isValidId(messageId));
        allow update, delete: if isAdmin() && isValidId(roomId) && isValidId(messageId);
      }
    }
  }
}
